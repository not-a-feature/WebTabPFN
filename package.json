{
  "name": "webtabpfn",
  "version": "0.2.0",
  "description": "Zero-install TabPFN classification and regression for browsers",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/not-a-feature/WebTabPFN.git"
  },
  "homepage": "https://github.com/not-a-feature/WebTabPFN#readme",
  "bugs": {
    "url": "https://github.com/not-a-feature/WebTabPFN/issues"
  },
  "keywords": [
    "tabpfn",
    "machine-learning",
    "webgpu",
    "wasm",
    "browser"
  ],
  "type": "module",
  "jsdelivr": "src/webtabpfn.js",
  "unpkg": "src/webtabpfn.js",
  "files": [
    "src/webtabpfn.js",
    "src/ort-wasm-simd-threaded.asyncify.mjs",
    "src/ort-wasm-simd-threaded.asyncify.wasm",
    "src/models/*-int4-*.onnx",
    "src/models/*-int8-*.onnx",
    "src/TABPFN_MODEL_LICENSE.txt",
    "src/ONNXRUNTIME_LICENSE.txt",
    "src/ONNXRUNTIME_THIRD_PARTY_NOTICES.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "check:package": "pnpm pack --dry-run",
    "plot:benchmark": "python scripts/plot-benchmarks.py",
    "start": "python -m http.server 4173",
    "test": "vitest run tests/unit",
    "test:browser": "pnpm build && playwright test --config tests/playwright.config.ts",
    "prepublishOnly": "pnpm test && pnpm test:browser && pnpm check:package"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "onnxruntime-web": "1.27.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
